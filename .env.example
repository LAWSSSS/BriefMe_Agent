# BriefMe 环境变量示例
# 复制为 .env 后填写。不要把 .env 提交到 Git。

# 对话模型
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 永锋：打包带视觉系统
YONGFENG_PACKING_BASE_URL=
YONGFENG_PACKING_USERNAME=
YONGFENG_PACKING_PASSWORD=

# 永锋：烧结矿与检判系统
YONGFENG_ACCOUNT=
YONGFENG_PASSWORD=
YONGFENG_VISUAL_USERNAME=
YONGFENG_VISUAL_PASSWORD=
YONGFENG_ANALYSIS_TOKEN=
YONGFENG_API_CODE=
YONGFENG_ANALYSIS_BASE_URL=
YONGFENG_ANALYSIS_QUERY_BASE_URL=
YONGFENG_VISUAL_1_BASE_URL=
YONGFENG_VISUAL_2_BASE_URL=

# 永锋：废钢检判原图下载
YONGFENG_SCRAP_BASE_URL=
YONGFENG_SCRAP_EMPLOYEE_ID=
YONGFENG_SCRAP_PASSWORD=
YONGFENG_SCP_HOST=
YONGFENG_SCP_PORT=22
YONGFENG_SCP_USER=
YONGFENG_SCP_ROOT=

# 永锋：数据集上传
YONGFENG_UPLOAD_BASE_URL=
YONGFENG_UPLOAD_USERNAME=
YONGFENG_UPLOAD_PASSWORD=
YONGFENG_UPLOAD_NAMESPACE=1
YONGFENG_UPLOAD_IMPURITY_NAME=
YONGFENG_UPLOAD_IMPURITY_ID=

# 永锋：VPN 状态探测
YONGFENG_VPN_GATEWAY=
YONGFENG_VPN_USERNAME=
YONGFENG_VPN_PASSWORD=
YONGFENG_VPN_CHECK_URL=

# 镔鑫钢铁
BINXIN_BASE_URL=
BINXIN_EMPLOYEE_ID=
BINXIN_PASSWORD=

# 盛隆钢铁
SHENGLONG_BASE_URL=
SHENGLONG_EMPLOYEE_ID=
SHENGLONG_PASSWORD=
SHENGLONG_SCP_HOST=
SHENGLONG_SCP_PORT=22
SHENGLONG_SCP_USER=
SHENGLONG_SCP_ROOT=

# 腾讯文档
TENCENT_DOCS_ENABLED=0
TENCENT_DOCS_AUTO_UPLOAD=0
TENCENT_DOCS_ACCESS_TOKEN=
TENCENT_DOCS_CLIENT_ID=
TENCENT_DOCS_OPEN_ID=

# 其它分析接口
ANALYSIS_TOKEN=
ANALYSIS_API_CODE=

# 可选：覆盖本地偏好与产物历史的保存位置
BRIEFME_PREFERENCES_PATH=
BRIEFME_ARTIFACT_HISTORY_PATH=
